ARG GO_VERSION=1.26.8
FROM mirror.gcr.io/library/golang:${GO_VERSION}-alpine AS go-builder
RUN apk add --no-cache git make
WORKDIR /workspace
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/proxy/ cmd/proxy/
COPY pkg/proxy/ pkg/proxy/
COPY pkg/kubeconfig/ pkg/kubeconfig/
COPY pkg/version/ pkg/version/
ARG GIT_COMMIT=dev
ARG BUILD_TIME=unknown
RUN CGO_ENABLED=0 go build \
    -ldflags="-X github.com/codeready-toolchain/cli-mcp-operator/pkg/version.commitOverride=${GIT_COMMIT} -X github.com/codeready-toolchain/cli-mcp-operator/pkg/version.BuildTime=${BUILD_TIME}" \
    -o bin/cli-mcp-proxy ./cmd/proxy/

FROM registry.access.redhat.com/ubi9/ubi-minimal:latest
# Public-trust kubernetes routes verify API certificates with this bundle.
RUN microdnf install -y ca-certificates && microdnf clean all
COPY --from=go-builder /workspace/bin/cli-mcp-proxy /usr/bin/
USER 1001
ENTRYPOINT ["/usr/bin/cli-mcp-proxy"]
